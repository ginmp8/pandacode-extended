{
  "expo": {
    "name": "PandaCode Extended",
    "slug": "pandacode-extended",
    "version": "0.5.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pandacode-extended",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ai.pandacode.extended.mobile",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "CFBundleDisplayName": "PandaCode Extended",
        "NSSupportsLiveActivities": true
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "ai.pandacode.extended.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "ai.pandacode.extended.mobile.LiveActivity",
          "groupIdentifier": "group.ai.pandacode.extended.mobile",
          "enablePushNotifications": false,
          "frequentUpdates": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "relayUrl": "",
      "githubClientId": "",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    },
    "platforms": [
      "ios",
      "android"
    ],
    "updates": {
      "enabled": false
    }
  }
}
