+    fn explicit_removal_prunes_deleted_targets_but_preserves_existing_selections() {
+        let fx = Fixture::new(); let store = crate::storage::Store::open(Path::new(":memory:")).unwrap();
+        skill(&fx, "Review", "Review code.");
