+    #[doc(alias = "g_signal_group_connect")]
+    #[inline]
+    pub fn connect<F>(&self, signal_name: &str, after: bool, callback: F)
+    where
+        F: Fn(&[Value]) -> Option<Value> + Send + Sync + 'static,
+    {
