+        unsafe extern "C" fn bind_trampoline<F: Fn(&SignalGroup, &Object)>(
+            this: *mut crate::gobject_ffi::GSignalGroup,
+            instance: *mut crate::gobject_ffi::GObject,
+            f: ffi::gpointer,
+        ) {
