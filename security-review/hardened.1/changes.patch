+    fn to_value(&self) -> crate::Value {
+        bool::from(*self).to_value()
+    }
+
+    fn value_type(&self) -> crate::Type {
+        <bool as crate::StaticType>::static_type()
+    }
+}
+
+impl From<Propagation> for crate::Value {
+    #[inline]
+    fn from(v: Propagation) -> Self {
+        bool::from(v).into()
+    }
