+    pub fn connect_closure(&self, signal_name: &str, after: bool, closure: RustClosure) {
+        unsafe {
+            gobject_ffi::g_signal_group_connect_closure(
+                self.to_glib_none().0,
+                signal_name.to_glib_none().0,
+                closure.as_ref().to_glib_none().0,
+                after.into_glib(),
+            );
+        }
+    }
