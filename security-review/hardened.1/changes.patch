+    /// Create a new Signal Identifier.
+    ///
+    /// # Safety
+    ///
+    /// The caller has to ensure it's a valid signal identifier.
+    #[inline]
+    pub unsafe fn new(id: NonZeroU32) -> Self {
+        Self(id)
+    }
