+#[inline(always)]
+fn fnmut_callback_wrapper(
+    func: impl FnOnce() + Send + 'static,
+) -> impl FnMut() -> ControlFlow + Send + 'static {
+    let mut func = Some(func);
+    move || {
+        let func = func
+            .take()
+            .expect("GSource closure called after returning ControlFlow::Break");
+        func();
+        ControlFlow::Break
+    }
