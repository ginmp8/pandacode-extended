+    #[test]
+    fn hash() {
+        // Get this first so the type is registered
+        let iu_type = InitiallyUnowned::static_type();
+
+        let set = Type::OBJECT
+            .children()
+            .iter()
+            .copied()
+            .collect::<HashSet<_>>();
+        assert!(set.contains(&iu_type));
+    }
