+pub fn spawn_future_local<R: 'static, F: std::future::Future<Output = R> + 'static>(
+    f: F,
+) -> crate::JoinHandle<R> {
+    let ctx = crate::MainContext::ref_thread_default();
+    ctx.spawn_local(f)
