+    macro_rules! signed {
+        ($name:ident, $ty:ident) => {
+            #[test]
+            fn $name() {
+                let mut n = $ty::max_value();
+                while n > 0 {
+                    let v = n.to_variant();
+                    assert_eq!(v.get(), Some(n));
+                    let v = (-n).to_variant();
+                    assert_eq!(v.get(), Some(-n));
+                    n /= 2;
+                }
+            }
+        };
