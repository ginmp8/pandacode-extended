+            self.as_ptr() as *mut _,
+            b"unbind\0".as_ptr() as *const _,
+            Some(transmute::<_, unsafe extern "C" fn()>(
+                unbind_trampoline::<F> as *const (),
+            )),
+            Box::into_raw(f),
+        )
