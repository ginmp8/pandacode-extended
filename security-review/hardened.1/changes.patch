+            let res = from_glib(ffi::g_unichar_compose(a.into(), b.into(), out.as_mut_ptr()));
+
+            if res {
+                Some(Self::unsafe_from(out.assume_init()))
+            } else {
+                None
+            }
+        }
+    }
