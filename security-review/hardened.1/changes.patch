+            _Foreign(ptr::NonNull<c_char>, usize),
+        }
+        assert_eq!(mem::size_of::<GString>(), mem::size_of::<NoInline>());
+        assert_eq!(mem::size_of::<GString>(), mem::size_of::<String>());
+    }
