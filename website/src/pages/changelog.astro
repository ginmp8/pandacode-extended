---
/* Historical upstream + Extended notes with independent source-qualified keys. */
import Page from '../layouts/Page.astro';
import { releases, formatDate, type Release } from '../lib/changelog';
const [latest] = releases;
// Preserve existing upstream anchors. Prefix Extended anchors to avoid future collisions.
const id = (release: Release) => (release.origin === 'extended' ? 'vextended-' : 'v') + release.version.replace(/[^A-Za-z0-9]+/g, '-');
const months = releases.reduce<{ label: string; items: Release[] }[]>((groups, release) => {
  const label = release.date ? new Date(`${release.date}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }) : 'Earlier';
  const last = groups.at(-1);
  return last?.label === label ? [...groups.slice(0, -1), { label, items: [...last.items, release] }] : [...groups, { label, items: [release] }];
}, []);
---
<Page title="Changelog" current="changelog" eyebrow="LITTLE BY LITTLE"
  heading="PandaCode Extended and original release history."
  description={`Original PandaCode references and Extended source revisions. Latest source note: ${latest.displayVersion}${latest.date ? `, ${formatDate(latest.date)}` : ''}.`}
  lede={`${releases.length} source notes, including upstream-only references; neither native release publication nor full upstream feature parity is implied.`}>
  <div slot="hero" class="changelog-latest page-rise">
    <span class="live-dot" aria-hidden="true"></span>Latest source note <a href={`#${id(latest)}`}>{latest.displayVersion}</a>{latest.date && <> · <time datetime={latest.date}>{formatDate(latest.date)}</time></>}
  </div>

  <div class="changelog-layout section-width">
    <nav class="changelog-rail" aria-label="Releases">
      {months.map(month => <div class="rail-month"><p>{month.label}</p><ul>{month.items.map(release => <li><a href={`#${id(release)}`} data-rail={id(release)}>{release.displayVersion}</a></li>)}</ul></div>)}
    </nav>
    <ol class="changelog-list">
      {releases.map((release, index) => (
        <li class="release reveal" id={id(release)} aria-labelledby={`${id(release)}-title`}>
          <div class="release-marker" aria-hidden="true"><span></span></div>
          <div class="release-meta">
            <h2 id={`${id(release)}-title`}><a href={`#${id(release)}`}>{release.displayVersion}</a></h2>
            {index === 0 && <span class="release-badge">Latest source note</span>}<span class="release-badge">{release.origin === 'upstream' ? 'Original reference' : release.version.includes('hardened') ? 'Extended legacy' : 'Extended source'}</span>
            {release.date && <time datetime={release.date}>{formatDate(release.date)}</time>}
          </div>
          <div class="release-body">
            {release.title && <h3>{release.title}</h3>}
            {release.blocks.map(block => block.kind === 'list'
              ? <ul>{block.items.map(item => <li><Fragment set:html={item.html} />{item.children.length > 0 && <ul>{item.children.map(child => <li set:html={child} />)}</ul>}</li>)}</ul>
              : <p set:html={block.html} />)}
          </div>
        </li>
      ))}
    </ol>
  </div>
  <p class="changelog-note section-width">These notes combine <a href="https://github.com/aicodeking/pandacode/releases">original PandaCode reference releases</a> and PandaCode Extended source history. A referenced upstream release does not mean its features or binaries are included in Extended. See <a href="https://github.com/ginmp8/pandacode-hardened/releases">the currently hosted Extended repository releases</a> for any explicitly published assets. Automatic upstream installers and application updates are disabled in this distribution.</p>
</Page>
